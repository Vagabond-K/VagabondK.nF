<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Common\Shared\SoakRunner.cs" Link="SoakRunner.cs" />
    <ProjectReference Include="..\..\..\Source\IEC61850\VagabondK.nF.IEC61850.SCL\VagabondK.nF.IEC61850.SCL.csproj" />
    <None Update="Fixtures\Data.scd" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(IntermediateOutputPath)GeneratedIec61850Model.g.cs" />
    <Compile Include="..\..\..\Source\IEC61850\VagabondK.nF.IEC61850\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\IEC61850\VagabondK.nF.IEC61850.Client\*.cs" Link="Client\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\MMS\VagabondK.nF.MMS\*.cs" Link="MMS\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\MMS\VagabondK.nF.MMS.Client\*.cs" Link="MmsClient\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\MMS\VagabondK.nF.MMS.Server\*.cs" Link="MmsServer\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\MMS\VagabondK.nF.MMS.TCP\*.cs" Link="TCP\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\IEC61850\VagabondK.nF.IEC61850.Server\*.cs" Link="Server\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Samples\IEC61850\VagabondK.nF.IEC61850.TCPClient\MonitorSession.cs" Link="Samples\MonitorSession.cs" />
  </ItemGroup>
  <Target Name="GenerateSclFixture" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\..\..\Source\IEC61850\VagabondK.nF.IEC61850.SCL\bin\$(Configuration)\net10.0\VagabondK.nF.IEC61850.SCL.dll&quot; &quot;$(MSBuildThisFileDirectory)Fixtures\Data.scd&quot; &quot;$(IntermediateOutputPath)GeneratedIec61850Model.g.cs&quot;" />
  </Target>
  <Import Project="..\..\..\Source\Shared\VagabondK.nF.Shared.projitems" Label="Shared" />
</Project>
