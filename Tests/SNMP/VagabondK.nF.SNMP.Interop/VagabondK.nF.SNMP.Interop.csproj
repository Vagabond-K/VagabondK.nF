    <Compile Include="..\..\..\Samples\SNMP\VagabondK.nF.SNMP.UDPHost\*.cs" Link="Sample\%(Filename)%(Extension)" />
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
  </ItemGroup>
</Project>
