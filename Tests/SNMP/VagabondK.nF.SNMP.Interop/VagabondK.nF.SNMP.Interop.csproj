    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <StartupObject>VagabondK.nF.SNMP.Interop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Source\SNMP\VagabondK.nF.SNMP\*.cs" Link="SnmpCore\%(Filename)%(Extension)" />
