    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Lextm.SharpSnmpLib" Version="12.5.7" />
    <Compile Include="..\..\..\Source\SNMP\VagabondK.nF.SNMP\*.cs" Link="Runtime\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Source\SNMP\VagabondK.nF.SNMP.UDP\*.cs" Link="Transport\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Samples\SNMP\VagabondK.nF.SNMP.Mapping\DeviceData.cs" Link="DeviceData.cs" />
    <Compile Include="..\VagabondK.nF.SNMP.Tests\Wire.cs" Link="Wire.cs" />
