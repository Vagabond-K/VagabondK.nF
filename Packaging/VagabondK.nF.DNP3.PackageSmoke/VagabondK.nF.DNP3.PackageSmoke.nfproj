<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><NanoFrameworkProjectSystemPath Condition="'$(NanoFrameworkProjectSystemPath)' == ''">$(MSBuildExtensionsPath)\nanoFramework\v1.0\</NanoFrameworkProjectSystemPath></PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props" />
  <PropertyGroup>
    <ProjectGuid>{310E1601-9B23-4A51-B344-100000000058}</ProjectGuid>
    <ProjectTypeGuids>{11A8DD76-328B-46DF-9F39-F559912D0360};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Exe</OutputType>
    <AssemblyName>VagabondK.nF.DNP3.PackageSmoke</AssemblyName>
    <StartupObject>VagabondK.nF.DNP3.PackageSmoke.Program</StartupObject>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputPath>bin\$(Configuration)\</OutputPath><IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <LangVersion>7.3</LangVersion><NoStdLib>true</NoStdLib><NoConfig>true</NoConfig>
    <Dnp3Role Condition="'$(Dnp3Role)' == ''">All</Dnp3Role>
    <SmokePackagesPath Condition="'$(SmokePackagesPath)' == ''">$(MSBuildProjectDirectory)\bin\packages\</SmokePackagesPath>
    <DefineConstants Condition="'$(Dnp3Role)' == 'All'">MASTER;OUTSTATION;TCP;SERIAL</DefineConstants>
    <DefineConstants Condition="'$(Dnp3Role)' == 'Master'">MASTER</DefineConstants>
    <DefineConstants Condition="'$(Dnp3Role)' == 'Outstation'">OUTSTATION</DefineConstants>
    <DefineConstants Condition="'$(Dnp3Role)' == 'Tcp'">TCP</DefineConstants>
    <DefineConstants Condition="'$(Dnp3Role)' == 'Serial'">SERIAL</DefineConstants>
  </PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.props" />
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="mscorlib"><HintPath>$(SmokePackagesPath)nanoFramework.CoreLibrary.1.17.11\lib\mscorlib.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="nanoFramework.Runtime.Native"><HintPath>$(SmokePackagesPath)nanoFramework.Runtime.Native.1.7.11\lib\nanoFramework.Runtime.Native.dll</HintPath></Reference>
    <Reference Include="VagabondK.nF.DNP3"><HintPath>$(SmokePackagesPath)VagabondK.nF.DNP3.0.1.0-preview.1\lib\VagabondK.nF.DNP3.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Dnp3Role)' == 'Master' Or '$(Dnp3Role)' == 'All'">
    <Reference Include="VagabondK.nF.DNP3.Master"><HintPath>$(SmokePackagesPath)VagabondK.nF.DNP3.Master.0.1.0-preview.1\lib\VagabondK.nF.DNP3.Master.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Dnp3Role)' == 'Outstation' Or '$(Dnp3Role)' == 'All'">
    <Reference Include="VagabondK.nF.DNP3.Outstation"><HintPath>$(SmokePackagesPath)VagabondK.nF.DNP3.Outstation.0.1.0-preview.1\lib\VagabondK.nF.DNP3.Outstation.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Dnp3Role)' == 'Tcp' Or '$(Dnp3Role)' == 'All'">
    <Reference Include="VagabondK.nF.DNP3.TCP"><HintPath>$(SmokePackagesPath)VagabondK.nF.DNP3.TCP.0.1.0-preview.1\lib\VagabondK.nF.DNP3.TCP.dll</HintPath></Reference>
    <Reference Include="System.Net"><HintPath>$(SmokePackagesPath)nanoFramework.System.Net.1.11.66\lib\System.Net.dll</HintPath></Reference>
    <Reference Include="nanoFramework.System.Text"><HintPath>$(SmokePackagesPath)nanoFramework.System.Text.1.3.42\lib\nanoFramework.System.Text.dll</HintPath></Reference>
    <Reference Include="System.Threading"><HintPath>$(SmokePackagesPath)nanoFramework.System.Threading.1.1.52\lib\System.Threading.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Dnp3Role)' == 'Serial' Or '$(Dnp3Role)' == 'All'">
    <Reference Include="VagabondK.nF.DNP3.Serial"><HintPath>$(SmokePackagesPath)VagabondK.nF.DNP3.Serial.0.1.0-preview.1\lib\VagabondK.nF.DNP3.Serial.dll</HintPath></Reference>
    <Reference Include="System.IO.Ports"><HintPath>$(SmokePackagesPath)nanoFramework.System.IO.Ports.1.1.142\lib\System.IO.Ports.dll</HintPath></Reference>
    <Reference Include="System.Threading"><HintPath>$(SmokePackagesPath)nanoFramework.System.Threading.1.1.52\lib\System.Threading.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(Dnp3Role)' == 'Tcp' Or '$(Dnp3Role)' == 'Serial' Or '$(Dnp3Role)' == 'All'">
    <Reference Include="System.IO.Streams"><HintPath>$(SmokePackagesPath)nanoFramework.System.IO.Streams.1.1.96\lib\System.IO.Streams.dll</HintPath></Reference>
    <Reference Include="nanoFramework.Runtime.Events"><HintPath>$(SmokePackagesPath)nanoFramework.Runtime.Events.1.11.39\lib\nanoFramework.Runtime.Events.dll</HintPath></Reference>
  </ItemGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets" />
</Project>
