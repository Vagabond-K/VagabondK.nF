  </ItemGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets" />
  <Import Project="$(SmokePackagesPath)VagabondK.nF.Modbus.Mapping.0.1.0-preview.1\build\VagabondK.nF.Modbus.Mapping.targets" />
