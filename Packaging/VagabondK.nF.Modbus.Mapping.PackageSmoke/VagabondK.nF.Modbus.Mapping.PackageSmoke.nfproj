<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NanoFrameworkProjectSystemPath Condition="'$(NanoFrameworkProjectSystemPath)' == ''">$(MSBuildExtensionsPath)\nanoFramework\v1.0\</NanoFrameworkProjectSystemPath>
  </PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.Default.props" />
  <PropertyGroup>
    <ProjectGuid>{310E1601-9B23-4A51-B344-100000000096}</ProjectGuid>
    <ProjectTypeGuids>{11A8DD76-328B-46DF-9F39-F559912D0360};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Exe</OutputType>
    <RootNamespace>VagabondK.nF.MappingPackageSmoke</RootNamespace>
    <AssemblyName>VagabondK.nF.Modbus.Mapping.PackageSmoke</AssemblyName>
    <TargetFrameworkVersion>v1.0</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
