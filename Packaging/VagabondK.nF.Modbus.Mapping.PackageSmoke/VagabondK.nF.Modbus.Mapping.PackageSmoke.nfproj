    <LangVersion>7.3</LangVersion>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <SmokePackagesPath Condition="'$(SmokePackagesPath)' == ''">$(MSBuildProjectDirectory)\bin\packages\</SmokePackagesPath>
  </PropertyGroup>
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.props" />
  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\$(MappingRole)-$(MappingBitsOnly)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(MappingRole)-$(MappingBitsOnly)\</IntermediateOutputPath>
    <DefineConstants Condition="'$(MappingRole)' == 'Client'">$(DefineConstants);MAPPING_CLIENT</DefineConstants>
    <DefineConstants Condition="'$(MappingBitsOnly)' == 'true'">$(DefineConstants);MAPPING_BITS_ONLY</DefineConstants>
