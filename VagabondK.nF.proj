  </ItemGroup>
  <Target Name="Build">
    <MSBuild Projects="@(BuildTool)" Targets="Restore;Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="@(ModbusLibrary);@(DNP3Library);@(BACnetLibrary);@(SNMPLibrary);@(MMSLibrary);@(IEC61850Library);@(MQTTLibrary);@(SparkplugLibrary)" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="Clean">
    <MSBuild Projects="@(BuildTool)" Targets="Clean" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="@(ModbusLibrary);@(DNP3Library);@(BACnetLibrary);@(SNMPLibrary);@(MMSLibrary);@(IEC61850Library);@(MQTTLibrary);@(SparkplugLibrary)" Targets="Clean" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="Rebuild">
    <MSBuild Projects="@(BuildTool)" Targets="Restore;Rebuild" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="@(ModbusLibrary);@(DNP3Library);@(BACnetLibrary);@(SNMPLibrary);@(MMSLibrary);@(IEC61850Library);@(MQTTLibrary);@(SparkplugLibrary)" Targets="Rebuild" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>