<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <Version>0.1.0-preview.1</Version>
    <Description>nanoFramework 모델을 IEC 61850 값·품질·시각·DataSet·URCB와 명시적 제어에 연결하는 빌드 전용 소스 생성기입니다. 평가용 사전 릴리스입니다.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <Compile Include="..\..\MMS\VagabondK.nF.MMS.Mapping\StaticMappingGenerator.cs" Link="StaticMappingGenerator.cs" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers\dotnet\cs" />
    <None Include="build\VagabondK.nF.IEC61850.Mapping.targets" Pack="true" PackagePath="build" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Shared\MappingAttributeSource.cs" Link="MappingAttributeSource.cs" />
  </ItemGroup>
  <Import Project="..\..\..\Build\Mapping.Package.targets" />
</Project>
