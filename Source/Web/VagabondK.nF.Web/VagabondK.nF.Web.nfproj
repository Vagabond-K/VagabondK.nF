<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup><ProjectGuid>{310E1601-9B23-4A51-B344-100000000192}</ProjectGuid></PropertyGroup>
  <Import Project="..\..\..\Build\Library.props" />
  <Import Project="..\..\..\Build\Network.props" />
  <PropertyGroup><DefineConstants>$(DefineConstants);NANOFRAMEWORK</DefineConstants></PropertyGroup>
  <!-- nanoFramework.WebServer 1.2.162는 System.Net 1.11.64 기준으로 컴파일되어 repo의 1.11.66과
       버전만 다릅니다(nanoFramework는 이름 기반 바인딩이라 실행에 지장 없음). CS1702만 억제합니다. -->
  <PropertyGroup><NoWarn>$(NoWarn);1702</NoWarn></PropertyGroup>
  <ItemGroup>
    <Reference Include="nanoFramework.System.Security.Cryptography">
      <HintPath>$(PackagesPath)nanoFramework.System.Security.Cryptography.1.0.43\lib\nanoFramework.System.Security.Cryptography.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(PackagesPath)nanoFramework.System.Net.Http.Server.1.5.214\lib\System.Net.Http.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="nanoFramework.WebServer">
      <HintPath>$(PackagesPath)nanoFramework.WebServer.1.2.162\lib\nanoFramework.WebServer.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.FileSystem">
      <HintPath>$(PackagesPath)nanoFramework.System.IO.FileSystem.1.1.96\lib\System.IO.FileSystem.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Import Project="..\..\..\Build\Library.targets" />
</Project>
