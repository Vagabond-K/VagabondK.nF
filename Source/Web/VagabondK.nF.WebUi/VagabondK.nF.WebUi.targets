<?xml version="1.0" encoding="utf-8"?>
<!--
  VagabondK.nF.WebUi: build-time page composer for nanoFramework management UIs.
  This file only wires inputs to VagabondK.nF.WebUi (a Roslyn source generator project,
  referenced from the consuming project as <ProjectReference OutputItemType="Analyzer" .../>).
  The generator merges shell + profile into one page, minifies/gzips it, and emits a C# class
  holding gzipped Base64 parts (so the device never stores the whole page in RAM).

  Usage (in a .nfproj/.csproj, after the language targets):
    <PropertyGroup>
      <WebUiShell>path\to\shell.html</WebUiShell>
      <WebUiProfile>path\to\profile.html</WebUiProfile>
      <WebUiNamespace>My.App</WebUiNamespace>   (default: VagabondK.nF.WebUi)
    </PropertyGroup>
  또는 페이지 모드(프로필 없는 단일 루트 페이지):
    <PropertyGroup>
      <WebUiPage>path\to\index.html</WebUiPage>
    </PropertyGroup>
  WebUiPage는 WebUiShell/WebUiProfile과 배타이며, 페이지가 셸 역할을 겸한다:
  @core/@style/@script 마커 필수, @manifest/@views 마커 선택(@manifest 줄에 같은 줄 JSON 허용).
  폼 필드는 페이지 마크업의 data-label/data-fmt에서 자동 유도된다.
    <Import Project="...\VagabondK.nF.WebUi.targets" />
    <ProjectReference Include="...\VagabondK.nF.WebUi.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />

  Markers (single-line HTML comments, written below as MARK:NAME):
    shell.html : MARK-manifest, MARK-core, MARK-style, MARK-views, MARK-script
    profile.html: MARK-manifest, MARK-style, MARK-views, MARK-script
    (each MARK-x stands for an HTML comment containing "@x")
  Components: $(WebUiComponents) 루트(기본: 프로젝트의 WebUi 폴더) 아래 어디든
    <name>.nf.html = 컴포넌트. 같은 이름 <name>.nf.js/.nf.css가 같은 폴더에 있으면 한 벌.
    일반 .html/.js/.css는 루트 아래에 있어도 컴포넌트가 아니다(shell·profile은 명시 경로).
    어디든 한 줄 토큰 MARK-use:NAME으로 삽입. html은 그 자리 인라인, css는 MARK-style
    앞쪽, js는 MARK-script 앞쪽에 자동 병합(자식→부모 순, 프로필이 오버라이드 가능).
    $(WebUiComponents)는 세미콜론 루트 목록 — 앞 루트(프로젝트 로컬)가 뒤 루트(공유)를
    섀도잉하고, 같은 루트 내 이름 중복은 오류.
    빌드타임 슬롯(MARK-slot)은 폐기됨: 확장 지점은 name.nf.html 컴포넌트로 만들고
    참조 위치에서 <name/>로 쓰면, 프로젝트 로컬 루트가 같은 이름의 공유 컴포넌트를
    섀도잉하여 제품별로 내용을 교체할 수 있다.
    html 첫 줄에 MARK-instance 마커가 있으면 인스턴스 컴포넌트: @use 자리는 <wui-name>
    태그, 마크업은 <template id="wui-t-name">로, js는 WUI.def init(root,document,$)으로
    번들링(shadow DOM, id 격리, 인스턴스별 상태). 마커 없으면 위 인라인 방식 그대로.
  @manifest holds one compact JSON object:
    { "id": "profile-id", "schema": 5,
      "form": [ { "name": "baudRate", "label": "...", "fmt": "ms|pin|secret|bool|text" }, ... ],
      "features": { "points": true, "scale": true, "name": false, "byteOrder": true,
                    "access": ["RO","RW"], "addr": { "s": {...}, "t": {...} },
                    "cacheCols": { "head": ["ID", ...] } } }
  "form"은 선택입니다. @views의 input/select/textarea에 data-label="..." / data-fmt="ms"를
  붙이면 생성기가 문서 순서로 form 항목을 자동 유도합니다(label 없으면 name 사용).
  수동 form과 data-* 병존 가능하지만 같은 name이 양쪽에 있으면 빌드 오류("keep one source").
  수동 항목 먼저 + 유도 항목 뒤. 유도 여부와 무관하게 MANIFEST에는 합쳐져 주입됩니다.
  <name/> 문법: name.nf.html 컴포넌트는 줄 전체로 쓸 때 @use 주석 대신 <name/> 태그로 참조할 수
  있습니다(br/img 등 void 요소명은 HTML로 통과, 미정의 이름은 빌드 오류). 두 표기는 혼용 가능.
  WebUiId 속성: 설정하면 manifest의 "id"를 대체합니다(선두 주입). manifest.id도 있고 값이 다르면
  빌드 오류, 같으면 무해. 둘 다 없으면 빌드 오류. 미설정이면 manifest.id가 그대로 쓰입니다.
  The generator validates the manifest (shape + cross-checks against views/script), injects
  `const MANIFEST = {...};` and Assets\core.js, then minifies/gzips/hashes the page.
  Validation failures surface as WUI001/WUI002 build errors pointing at the offending file.
  Legacy per-profile globals (PROFILE, KEYS, LABELS, formValues, fillForm, profileDirty,
  profileExport, profileImport, showValue, profileAddr, profileScale, profileAccess,
  profilePoints, profileName, profileByteOrder, profileCacheCols) are build errors.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebUiCore Condition="'$(WebUiCore)' == ''">$(MSBuildThisFileDirectory)Assets\core.js</WebUiCore>
    <WebUiNamespace Condition="'$(WebUiNamespace)' == ''">VagabondK.nF.WebUi</WebUiNamespace>
    <WebUiClassName Condition="'$(WebUiClassName)' == ''">WebPage</WebUiClassName>
    <WebUiComponents Condition="'$(WebUiComponents)' == ''">$(MSBuildProjectDirectory)\WebUi</WebUiComponents>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(WebUiShell)" Condition="'$(WebUiShell)' != ''" />
    <AdditionalFiles Include="$(WebUiProfile)" Condition="'$(WebUiProfile)' != ''" />
    <AdditionalFiles Include="$(WebUiPage)" Condition="'$(WebUiPage)' != ''" />
    <AdditionalFiles Include="$(WebUiCore)" />
    <!-- @use 컴포넌트 조각: 루트 아래 어디든 <name>.nf.{html,js,css} (없으면 빈 glob).
         WebUiComponents가 세미콜론 목록이므로 타깃 실행 시점에 루트별로 배치한다(평가 시점 glob은 세미콜론에서 깨짐). -->
  </ItemGroup>
  <Target Name="WebUiWriteGeneratorConfig" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_WebUiCompRoots Include="$(WebUiComponents)" />
      <AdditionalFiles Include="%(_WebUiCompRoots.Identity)\**\*.nf.html" />
      <AdditionalFiles Include="%(_WebUiCompRoots.Identity)\**\*.nf.js" />
      <AdditionalFiles Include="%(_WebUiCompRoots.Identity)\**\*.nf.css" />
    </ItemGroup>
    <PropertyGroup>
      <_WebUiCfgPath>$(IntermediateOutputPath)webui.generator.globalconfig</_WebUiCfgPath>
      <!-- 값의 세미콜론은 WriteLinesToFile이 줄 구분자로 삼으므로 '|'로 인코딩해 저장한다. -->
      <_WebUiCfgDesired>is_global=true&#xa;webui_namespace=$(WebUiNamespace)&#xa;webui_class_name=$(WebUiClassName)&#xa;webui_shell=$(WebUiShell)&#xa;webui_profile=$(WebUiProfile)&#xa;webui_core=$(WebUiCore)&#xa;webui_components=$([System.String]::Copy('$(WebUiComponents)').Replace(';', '|'))&#xa;webui_id=$(WebUiId)&#xa;webui_page=$(WebUiPage)</_WebUiCfgDesired>
      <_WebUiCfgExisting Condition="Exists('$(_WebUiCfgPath)')">$([System.String]::Copy($([System.IO.File]::ReadAllText('$(_WebUiCfgPath)'))).Trim())</_WebUiCfgExisting>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_WebUiCfgPath)" Lines="$(_WebUiCfgDesired)" Overwrite="true"
                      Condition="'$(_WebUiCfgExisting)' != '$([System.String]::Copy($(_WebUiCfgDesired)).Trim())'" />
    <ItemGroup>
      <!-- Csc의 /analyzerconfig 바인딩은 두 toolchain 모두 @(EditorConfigFiles)다. -->
      <EditorConfigFiles Include="$(_WebUiCfgPath)" />
      <FileWrites Include="$(_WebUiCfgPath)" />
      <!-- 생성기 입력(페이지/코어/컴포넌트)은 @(Compile)이 아니라 CoreCompile up-to-date 검사에
           기본 포함되지 않는다. 명시로 추가해 파일 편집 후 재빌드 시 생성기가 반드시 다시
           실행되게 한다(안 그러면 이전 페이지가 조용히 재번들됨 — 2026-11 실측). -->
      <CustomAdditionalCompileInputs Include="@(AdditionalFiles)" />
    </ItemGroup>
  </Target>
</Project>
