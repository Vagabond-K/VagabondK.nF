<?xml version="1.0" encoding="utf-8"?>
<!--
  VagabondK.nF.WebUi: build-time page composer for nanoFramework management UIs.
  이 파일은 VagabondK.nF.WebUi.Tasks.GenerateWebUiResourcesTask(MSBuild 태스크)에 입력을
  연결한다. 태스크는 페이지/컴포넌트를 조립·압축해 gzip 바이트를 nanoFramework *바이너리
  리소스*(.resx -> PE에 박히는 .nanoresources)로 만들고, 디자이너(WebPage.resources.cs)와
  라우터(WebUiRoutes.g.cs)를 생성한다. 장치는 flash에서 슬라이스로 직접 읽는다.

  ===== 라우팅: 파일이 곧 라우트 (2026-11 전환) =====
  페이지는 더 이상 MSBuild 속성(WebUiPage/Shell/Profile)으로 지정하지 않는다.
  $(WebUiComponents) 루트(기본: 프로젝트의 WebUi 폴더 + 라이브러리 Components\ + Pages\) 아래
  어떤 `.nf.html`이든 첫 줄의 route 마커(XML 주석 한 줄 형태)로 라우팅된다:

    @route:/login login    -> GET /login, 로그인 페이지(텍스트 부분집합 인라인, no-store)
    @route:/ public        -> GET /public, 인증 요구 없는 페이지
    @route:/               -> GET /, 보호된 페이지(기본)
    (마커 없음)             -> 페이지 아님: <name/>로 인라인되는 일반 컴포넌트
    @route:none            -> 빌드 산출물에서 제외(섀도잉 전용)

  옵션: login = LoginPagePath 지정 + 텍스트 부분집합 인라인 + no-store 서빙 + 로그인 상태에서
  "/"로 302. public = [PublicEndpoint](비로그인 서빙). 없으면 보호(fail-closed).
  페이지 승자 규칙: 루트 오름차순 첫 encounter(프로젝트 로컬이 공유 패키지를 섀도잉),
  같은 루트 내 동명 재등장은 빌드 오류.

  앱 연결(컨트롤러 목록에 한 줄):
    var server = new GuardedWebServer(80, new Type[] { typeof(MyApi), typeof(WebUiRoutes) }, guard);
    server.LoginPagePath = WebUiRoutes.LoginPath;   // login 옵션 페이지가 있을 때

  사용 (.nfproj/.csproj, language targets 이후):
    <PropertyGroup>
      <WebUiId>myproduct</WebUiId>              (선택: manifest.id 대체)
      <WebUiBrand>My Product</WebUiBrand>        (선택: {{BRAND}} 치환, 기본 프로젝트명)
      <WebUiLinkCss>true</WebUiLinkCss>          (선택: css를 /style.css 자산으로 분리)
    </PropertyGroup>
    <Import Project="...\VagabondK.nF.WebUi.targets" />
  소비 프로젝트는 nanoFramework.ResourceManager·nanoFramework.Runtime.Native를 참조해야 한다.

  컴포넌트 상세(@use/@instance/@core/@style/@script/@manifest 마커, 텍스트 사전 texts*.resx,
  data-label/data-fmt 자동 유도 등)은 README.md와 PageComposer.cs 주석을参照.
  페이지의 own 자산 <name>.nf.css / <name>.nf.js는 페이지 html의 @style/@script 자리에
  항상 인라인된다(테마/컴포넌트 css보다 앞).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebUiCore Condition="'$(WebUiCore)' == ''">$(MSBuildThisFileDirectory)Assets\core.js</WebUiCore>
    <!-- 공용 i18n 런타임(uiText/uiLang): 라우터가 /i18n.js 자산으로 서빙한다.
         texts.js(사전) 다음, 페이지 스크립트 전에 로드된다. -->
    <WebUiI18n Condition="'$(WebUiI18n)' == ''">$(MSBuildThisFileDirectory)Assets\i18n.js</WebUiI18n>
    <WebUiNamespace Condition="'$(WebUiNamespace)' == ''">VagabondK.nF.WebUi</WebUiNamespace>
    <WebUiClassName Condition="'$(WebUiClassName)' == ''">WebPage</WebUiClassName>
    <WebUiComponents Condition="'$(WebUiComponents)' == ''">$(MSBuildProjectDirectory)\WebUi</WebUiComponents>
    <!-- 표준 자산 루트: 라이브러리의 Components\(컴포넌트+texts*.resx 사전)와 Pages\(표준
         로그인 페이지). repo와 NuGet 패키지에서 같은 상대 위치. 비활성화는 WebUiNoSharedComponents=true. -->
    <WebUiSharedComponents Condition="'$(WebUiNoSharedComponents)' != 'true' and '$(WebUiSharedComponents)' == '' and Exists('$(MSBuildThisFileDirectory)Components')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)Components'))</WebUiSharedComponents>
    <WebUiSharedPages Condition="'$(WebUiNoSharedComponents)' != 'true' and '$(WebUiSharedPages)' == '' and Exists('$(MSBuildThisFileDirectory)Pages')">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)Pages'))</WebUiSharedPages>
    <!-- ResourceManager baseName: 생성되는 EmbeddedResource의 ManifestResourceName과
         WebPage 클래스가 새로 만든다. 두 곳이 같은 속성을 읽어 항상 일치한다. -->
    <WebUiResourceName Condition="'$(WebUiResourceName)' == ''">$(WebUiNamespace).WebUiResources</WebUiResourceName>
    <WebUiOutDir>$(IntermediateOutputPath)webui\</WebUiOutDir>
    <!-- 공유 테마(:root 토큰 css): 모든 페이지가 같은 색감을 쓴다. 기본 Assets\theme.css.
         자기 색감은 이 속성을 프로젝트 파일로 덮어쓴다(예: 샘플의 WebUi\theme.css). -->
    <WebUiTheme Condition="'$(WebUiTheme)' == '' and Exists('$(MSBuildThisFileDirectory)Assets\theme.css')">$(MSBuildThisFileDirectory)Assets\theme.css</WebUiTheme>
    <!-- {{BRAND}} 치환문(표준 로그인 페이지·manifest에 주입). 기본은 프로젝트명. -->
    <WebUiBrand Condition="'$(WebUiBrand)' == ''">$(MSBuildProjectName)</WebUiBrand>
    <!-- WebUiLinkCss=true: 페이지별 own css 외 테마+컴포넌트 css를 /style.css 한 자산으로
         분리(라우터가 서빙). js는 항상 인라인. -->
    <WebUiLinkCss Condition="'$(WebUiLinkCss)' == ''">false</WebUiLinkCss>
    <!-- 태스크 어셈블리: NuGet 패키지 동봉 dll(build\tools\, 패키지 모드)을 우선하고,
         없으면 소스 트리 산출물(repo 모드)을 쓴다. MSBuild 호스트 TFM도 함께 고른다. -->
    <WebUiTaskAssembly Condition="'$(WebUiTaskAssembly)' == '' and '$(MSBuildRuntimeType)' == 'Core' and Exists('$(MSBuildThisFileDirectory)tools\netstandard2.0\VagabondK.nF.WebUi.Tasks.dll')">$(MSBuildThisFileDirectory)tools\netstandard2.0\VagabondK.nF.WebUi.Tasks.dll</WebUiTaskAssembly>
    <WebUiTaskAssembly Condition="'$(WebUiTaskAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)tools\net472\VagabondK.nF.WebUi.Tasks.dll')">$(MSBuildThisFileDirectory)tools\net472\VagabondK.nF.WebUi.Tasks.dll</WebUiTaskAssembly>
    <WebUiTaskAssembly Condition="'$(WebUiTaskAssembly)' == '' and '$(MSBuildRuntimeType)' == 'Core'">$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\bin\$(Configuration)\netstandard2.0\VagabondK.nF.WebUi.Tasks.dll</WebUiTaskAssembly>
    <WebUiTaskAssembly Condition="'$(WebUiTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\bin\$(Configuration)\net472\VagabondK.nF.WebUi.Tasks.dll</WebUiTaskAssembly>
  </PropertyGroup>

  <!-- 폐지된 라우팅 속성 감지: 쓰면 마이그레이션 안내와 함께 빌드 실패(fail-closed). -->
  <Target Name="WebUiRoutingMigration" BeforeTargets="WebUiBuildTask">
    <Error Condition="'$(WebUiPage)' != '' or '$(WebUiShell)' != '' or '$(WebUiProfile)' != '' or '$(WebUiLogin)' != '' or '$(WebUiLoginPage)' != '' or '$(WebUiLoginStyle)' != '' or '$(WebUiLoginScript)' != '' or '$(WebUiLoginBrand)' != ''"
           Text="VagabondK.nF.WebUi routing is now marker-based: put .nf.html pages under the WebUiComponents roots and declare each route on the file's first line with &lt;!--@route:/path options--&gt; (options: login | public | none). Remove WebUiPage/WebUiShell/WebUiProfile/WebUiLogin* properties. The standard login page ships as Pages\login.nf.html; shadow it with a project-local login.nf.html if needed. Use WebUiBrand instead of WebUiLoginBrand." />
  </Target>

  <!-- 표준 자산 루트 자동 후미 추가(멱등): 이미 목록에 있으면 건너뛴다.
       후미이므로 프로젝트 로컬 루트가 패키지를 섀도잉하는 규칙이 유지된다. -->
  <!-- 주의: @() 항목 참조를 프로퍼티 값에 넣으면 지연 평가되어 목표 실행 시점에 풀린다.
       문자열 함수로 이 순간 즉시 판정한다(대/소문자·구분자 차이가 달라도 중복 루트는
       무해 — 앞 루트 우선 섀도잉이라 같은 폴더를 두 번 훑는 것뿐). -->
  <PropertyGroup>
    <_WuiSharedPresent Condition="'$(WebUiSharedComponents)' != ''">$([System.String]::Copy('$(WebUiComponents)').Contains('$(WebUiSharedComponents)'))</_WuiSharedPresent>
    <_WuiSharedPagesPresent Condition="'$(WebUiSharedPages)' != ''">$([System.String]::Copy('$(WebUiComponents)').Contains('$(WebUiSharedPages)'))</_WuiSharedPagesPresent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WebUiNoSharedComponents)' != 'true'">
    <WebUiComponents Condition="'$(WebUiSharedComponents)' != '' and '$(_WuiSharedPresent)' != 'True'">$(WebUiComponents);$(WebUiSharedComponents)</WebUiComponents>
    <WebUiComponents Condition="'$(WebUiSharedPages)' != '' and '$(_WuiSharedPagesPresent)' != 'True'">$(WebUiComponents);$(WebUiSharedPages)</WebUiComponents>
  </PropertyGroup>

  <UsingTask TaskName="VagabondK.nF.WebUi.Tasks.GenerateWebUiResourcesTask" AssemblyFile="$(WebUiTaskAssembly)" />

  <!-- 태스크 자체를 먼저 빌드(최초 1회, 이후 up-to-date). 파일 기준이라 VS와 CLI 모두에서 동작.
       패키지 모드(Tasks csproj가 없는 위치의 targets)에서는 건너뛴다 — dll은 build\tools 동봉. -->
  <Target Name="WebUiBuildTask" BeforeTargets="WebUiGenerateResources"
          Condition="Exists('$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\VagabondK.nF.WebUi.Tasks.csproj')"
          Inputs="$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\GenerateWebUiResourcesTask.cs;$(MSBuildThisFileDirectory)PageComposer.cs;$(MSBuildThisFileDirectory)MiniJson.cs;$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\VagabondK.nF.WebUi.Tasks.csproj"
          Outputs="$(WebUiTaskAssembly)">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\VagabondK.nF.WebUi.Tasks\VagabondK.nF.WebUi.Tasks.csproj"
             Properties="Configuration=$(Configuration)" Targets="Build" />
  </Target>

  <!-- gzip 페이지를 nanoFramework 바이너리 리소스로 구워 PE에 박고, 디자이너+라우터를 Compile에 넣는다. -->
  <Target Name="WebUiGenerateResources" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_WebUiCompRoots Include="$(WebUiComponents)" />
    </ItemGroup>
    <GenerateWebUiResourcesTask ResourceName="$(WebUiResourceName)"
                            WebUiCore="$(WebUiCore)" WebUiComponents="$(WebUiComponents)"
                            WebUiId="$(WebUiId)" WebUiNamespace="$(WebUiNamespace)" WebUiClassName="$(WebUiClassName)"
                            WebUiTheme="$(WebUiTheme)" WebUiBrand="$(WebUiBrand)"
                            WebUiLinkCss="$(WebUiLinkCss)" WebUiI18n="$(WebUiI18n)"
                            OutputDirectory="$(WebUiOutDir)">
      <Output TaskParameter="ResxFile" ItemName="_WebUiResx" />
      <Output TaskParameter="DesignerFile" ItemName="_WebUiDesigner" />
      <Output TaskParameter="RoutesFile" ItemName="_WebUiRoutes" />
    </GenerateWebUiResourcesTask>
    <ItemGroup>
      <EmbeddedResource Include="@(_WebUiResx)">
        <ManifestResourceName>$(WebUiResourceName)</ManifestResourceName>
        <!-- VS 체인의 Common CoreResGen이 같은 resx를 다시 처리하면 csc /resource가
             중복되므로 Common 경로에는 참여하지 않고(false), 아래 직접 호출만 실행한다. -->
        <Type>Resx</Type>
        <WithCulture>false</WithCulture>
        <GenerateResource>false</GenerateResource>
      </EmbeddedResource>
      <!-- 생성 소스 주입은 WebUiAddGeneratedSources(CoreCompile 직전)로 분리했다.
           평가 시점 항목에 두지 않는 이유: VS 트리는 평가 목록 기준이라 obj 폴더 노드가
           보이고, design-time 빌드는 CoreCompile 체인을 실행하므로 그쪽이 정확하다. -->
      <FileWrites Include="$(WebUiOutDir)WebUiResources.resx;$(WebUiOutDir)WebPage.resources.cs;$(WebUiOutDir)WebUiRoutes.g.cs" />
      <FileWrites Include="$(WebUiOutDir)page_*.bin" />
      <!-- 페이지/컴포넌트 입력 변경이 있으면 CoreCompile을 다시 태운다. -->
      <CustomAdditionalCompileInputs Include="$(WebUiCore);$(WebUiI18n);$(WebUiTheme)" />
      <CustomAdditionalCompileInputs Include="%(_WebUiCompRoots.Identity)\**\*.nf.html" />
      <CustomAdditionalCompileInputs Include="%(_WebUiCompRoots.Identity)\**\*.nf.js" />
      <CustomAdditionalCompileInputs Include="%(_WebUiCompRoots.Identity)\**\*.nf.css" />
      <CustomAdditionalCompileInputs Include="%(_WebUiCompRoots.Identity)\**\texts*.resx" />
    </ItemGroup>
    <!-- NF CLI 체인은 PrepareResources/CoreResGen 본문을 실행하지 않아 resx가 .resources로
         변환되지 않고(CoreCompile의 /resource 인자 실종), 결국 .exe/.pe/.bin에 리소스가
         안 박힌다(VS 체인은 정상 실행). Common이 하는 일을 여기서 직접 수행한다:
         resx → .resources 변환 후 csc가 소비하는 _CoreCompileResourceInputs에 주입. -->
    <GenerateResource Condition="'@(_WebUiResx)' != ''"
        Sources="@(_WebUiResx)"
        ExecuteAsTool="false"
        UseSourcePath="true"
        StateFile="$(IntermediateOutputPath)$(MSBuildProjectFile).WebUiGenerateResource.Cache"
        OutputResources="@(_WebUiResx->'$(IntermediateOutputPath)$(WebUiResourceName).resources')">
      <Output TaskParameter="Sources" ItemName="_WebUiGenSources" />
      <Output TaskParameter="FilesWritten" ItemName="FileWrites" />
    </GenerateResource>
    <ItemGroup Condition="'@(_WebUiGenSources)' != ''">
      <_CoreCompileResourceInputs Include="@(_WebUiGenSources->'%(OutputResource)')">
        <ManifestResourceName>$(WebUiResourceName)</ManifestResourceName>
      </_CoreCompileResourceInputs>
    </ItemGroup>
  </Target>

  <!-- 생성 소스를 컴파일 직전에 주입: 평가 시점 항목에 두면 VS 트리에 obj\Debug\webui
       폴더(폴더만)가 표시되고 삭제 경고까지 유발한다. design-time 빌드는 CoreCompile
       체인을 실행하므로 이 지점이 IntelliSense에 정확하고 트리도 깨끗하다.
       클린 직후(파일 없음)엔 0건이며 첫 빌드(실제/design-time)에서 생성·주입된다. -->
  <Target Name="WebUiAddGeneratedSources" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(WebUiOutDir)*.cs" />
    </ItemGroup>
  </Target>
</Project>
