<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.CSharp.targets" />
  <PropertyGroup Condition="'$(OutputType)' == 'Library'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <Target Name="ValidateBoard" BeforeTargets="CoreCompile"
          Condition="'$(Board)' != '' and '$(Board)' != 'GeekbleNano' and '$(Board)' != 'GeekbleMini'">
    <Error Text="Board '$(Board)' is not supported. Use GeekbleNano or GeekbleMini." />
  </Target>
</Project>
